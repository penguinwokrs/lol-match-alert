{
  // NOT VERIFIED ON HARDWARE. Pulsar's web configurator (bbb.pulsar.gg, its "sKey" app) names both
  // product ids "PCMK 3 TKL" in its firmware logs.
  //
  // SayoDevice firmware: the 48-byte LED effect block is read and written with command 0x26 on report
  // 0x22. The configurator follows every write with 0x0D, "save all", which is never sent here; if the
  // firmware only shows lighting once saved, the keyboard simply does not light. Writes are kept rare
  // until an owner confirms what a lone 0x26 does: one step a second at most, and by default the
  // keyboard's own breathing effect, one write per alert.
  "id": "pulsar-pcmk-3-he-tkl",
  "name": "Pulsar PCMK 3 HE TKL",
  "driver": "sayo",
  "match": { "vendorId": "0x3710", "productIds": [ "0x2502", "0x2504" ] },
  // mode * 16 + sub-mode: Basic / Solid Color, Breath / Breathing.
  "effects": { "solid": 80, "breathing": 48 },
  "minStepMs": 1000,
  "defaultPattern": "pulse"
}
