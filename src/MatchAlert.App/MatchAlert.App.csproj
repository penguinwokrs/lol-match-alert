<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MatchAlert.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MatchAlert.Domain\MatchAlert.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Named explicitly: default manifest names differ between Windows and Linux builds. -->
    <EmbeddedResource Include="BuiltIn\patterns.json" LogicalName="builtin/patterns.json" />
