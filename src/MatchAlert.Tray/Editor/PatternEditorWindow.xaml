<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:MatchAlert.Tray.Editor"
        x:Class="MatchAlert.Tray.Editor.PatternEditorWindow"
        x:ClassModifier="internal"
        Width="1000" Height="780" MinWidth="860" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#FF202225"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- The same dark surface as OpenInzone's settings window. -->
    <SolidColorBrush x:Key="Text" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="Quiet" Color="#FF9AA0A6" />
    <SolidColorBrush x:Key="Panel" Color="#FF26292D" />
    <SolidColorBrush x:Key="Line" Color="#FF3A3D42" />
    <SolidColorBrush x:Key="Accent" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="Warn" Color="#FFF2B84B" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Quiet}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="CaretBrush" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- The stock button is light chrome, and turns white when disabled; this one dims instead. -->
    <Style TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="#FF2F3237" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF6B7078" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource Quiet}" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,26,0"
                                VerticalAlignment="Center" IsHitTestVisible="False" />
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Slide">
                <Border Background="#FF2A2D31" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FF3A3D42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Which pattern -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <TextBlock x:Name="PatternLabel" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left" />
      <ComboBox x:Name="PatternBox" Width="300" DockPanel.Dock="Left" />
      <Button x:Name="NewButton" DockPanel.Dock="Left" Margin="12,0,0,0" />
      <Button x:Name="DuplicateButton" DockPanel.Dock="Left" />
      <Button x:Name="RenameButton" DockPanel.Dock="Left" />
      <Button x:Name="DeleteButton" DockPanel.Dock="Left" />
    </DockPanel>

    <!-- What it looks like -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="PreviewLabel" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource Quiet}" />
      <Border x:Name="PreviewStrip" Grid.Column="1" Height="40" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="Black" />
    </Grid>

    <!-- The steps -->
    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="TimelineHint" Style="{StaticResource Hint}" Margin="0,0,0,6" />
      <ed:TimelineControl x:Name="Timeline" />
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <!-- The selected step -->
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock x:Name="StepHeading" Style="{StaticResource Heading}" DockPanel.Dock="Top" />
          <ed:ColorWheel x:Name="Wheel" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,20,0" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
              <RowDefinition Height="38" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ColorLabel" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
              <Border x:Name="Swatch" Width="30" Height="26" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1" />
              <TextBox x:Name="HexBox" Width="96" Margin="8,0,0,0" FontFamily="Consolas" Height="28" />
              <CheckBox x:Name="OffBox" Margin="14,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="BrightnessLabel" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="BrightnessSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" />
            <TextBlock x:Name="BrightnessValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <TextBlock x:Name="EffectLabel" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="SteadyRadio" GroupName="Effect" />
              <RadioButton x:Name="BreathingRadio" GroupName="Effect" />
            </StackPanel>

            <TextBlock x:Name="SpeedLabel" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="SpeedSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="5" LargeChange="25" />
            <TextBlock x:Name="SpeedValue" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <TextBlock x:Name="DurationLabel" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBox x:Name="DurationBox" Width="80" Height="28" />
              <Button x:Name="EarlierButton" Content="◀" Margin="12,0,0,0" Padding="10,0" />
              <Button x:Name="LaterButton" Content="▶" Padding="10,0" />
              <Button x:Name="RemoveStepButton" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- The whole pattern, and who plays what -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="RepeatHeading" Style="{StaticResource Heading}" />
              <RadioButton x:Name="UntilEndRadio" GroupName="Repeat" Margin="0,0,0,8" />
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="CountRadio" GroupName="Repeat" Margin="0" />
                <TextBox x:Name="CountBox" Width="44" Height="26" Margin="6,0,6,0" />
                <TextBlock x:Name="TimesLabel" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock x:Name="KeyboardsHeading" Style="{StaticResource Heading}" />
              <StackPanel x:Name="KeyboardsPanel" />
              <TextBlock x:Name="DefaultLabel" Foreground="{StaticResource Quiet}" Margin="0,12,0,4" />
              <ComboBox x:Name="DefaultBox" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="NotesText" Foreground="{StaticResource Warn}" Margin="2,12,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- See it on the keyboard, and keep it -->
    <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="True">
      <CheckBox x:Name="LiveBox" DockPanel.Dock="Left" FontWeight="SemiBold" />
      <ComboBox x:Name="LiveDeviceBox" DockPanel.Dock="Left" Width="260" Margin="12,0,0,0" />
      <Button x:Name="CloseButton" DockPanel.Dock="Right" />
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Background="#FF2A5DB0" BorderBrush="#FF3B6FC4" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0" Foreground="{StaticResource Quiet}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
    </DockPanel>
  </Grid>
</Window>
